# PHÉNIX 360 — exemple de variables d'environnement.
# Portabilité (ADR-004 §2.5) : changer d'hébergement = changer ces variables,
# jamais le code. Copier vers des fichiers .env locaux (non commités).

# --- Supabase (cœur de données) ---
# V1 : projet Supabase Cloud (région UE). Demain : instance self-host souveraine.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key            # exposé au front (RLS protège la donnée)
SUPABASE_SERVICE_ROLE_KEY=service-role-key   # PASSERELLE UNIQUEMENT — jamais côté navigateur

# --- Passerelle IA (apps/gateway) ---
GATEWAY_URL=http://localhost:8000
MISTRAL_API_KEY=                              # passerelle uniquement ; jamais exposé au client

# --- Notifications (canal primaire V1 : e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM="PHÉNIX 360 <no-reply@phenix360.fr>"
